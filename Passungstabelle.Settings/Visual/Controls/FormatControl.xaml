<UserControl x:Class="Passungstabelle.Settings.FormatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Passungstabelle.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type local:FormatViewModel}, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Passungstabelle.Settings;component/Visual/CustomStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToEnumConverter x:Key="EnumConverter"/>
            <ObjectDataProvider x:Key="BlattFormatItemsSource"
                                ObjectType="{x:Type sys:Enum}"
                                MethodName="GetValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="{x:Type local:SheetFormat }" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Visibility x:Key="ZoneVisibility">Collapsed</Visibility>
            <Style x:Key="ZoneTextBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="40" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FFC6FDC6" />
                <Setter Property="Visibility" Value="{StaticResource ZoneVisibility}"/>
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Foreground" Value="Gray" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MarginTextBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="40" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="LemonChiffon" />
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Foreground" Value="Gray" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="250"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <GroupBox Header="{local:UiText GroupFormatSettingsHeader}" Grid.Column="1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="{local:UiText OptionNameHeader}" Grid.Column="0">
                    <TextBox Text="{Binding Name}" Margin="25,2,5,2"/>
                </GroupBox>

                <GroupBox Header="{local:UiText OptionSheetFormatHeader}" Grid.Column="1">
                    <ComboBox Margin="25,2,5,2" 
                              SelectedItem="{Binding SheetFormat}"
                              ItemsSource="{Binding Source={StaticResource BlattFormatItemsSource}}"/>
                </GroupBox>

                <GroupBox Header="{local:UiText GroupInsertPositionsHeader}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <UniformGrid Columns="2" >
                        <RadioButton Content="{local:UiText OptionTopLeft}"
                                     IsChecked="{Binding InsertPoint, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static local:TableInsertPoint.TopLeft}}"
                                     Margin="5,4"
                                     />
                        <RadioButton Content="{local:UiText OptionTopRight}"
                                     IsChecked="{Binding InsertPoint, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static local:TableInsertPoint.TopRight}}"
                                     Margin="5,4"
                                     FlowDirection="RightToLeft"
                                     />
                        <RadioButton Content="{local:UiText OptionBottomLeft}"
                                     IsChecked="{Binding InsertPoint, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static local:TableInsertPoint.BottomLeft}}"
                                     Margin="5,3"
                                     />
                        <RadioButton Content="{local:UiText OptionBottomRight}"
                                     IsChecked="{Binding InsertPoint, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static local:TableInsertPoint.BottomRight}}"
                                     Margin="5,3"  
                                     FlowDirection="RightToLeft"
                                     />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="{local:UiText GroupOffsetHeader}" Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2">
                    <UniformGrid Columns="2" Grid.IsSharedSizeScope="True">
                        <HeaderedContentControl Header="X: " 
                                                Template="{StaticResource HorizontalHeader}" 
                                                Margin="5"
                                                Padding="8,0,0,0">
                            <TextBox Text="{Binding OffsetX}" 
                                     VerticalContentAlignment="Center"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Y: "
                                                Template="{StaticResource HorizontalHeader}"
                                                Margin="5"
                                                Padding="8,0,0,0"
                                                >
                            <TextBox Text="{Binding OffsetY}" 
                                     VerticalContentAlignment="Center"/>
                        </HeaderedContentControl>
                    </UniformGrid>
                </GroupBox>

                <GroupBox  Grid.Row="3" Grid.ColumnSpan="2" MinHeight="200">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:UiText GroupMarginHeader}"
                                       Background="LemonChiffon"/>
                            <TextBlock Text="/" Margin="10,0"
                                       Visibility="{StaticResource ZoneVisibility}"
                                       />
                            <TextBlock Text="{local:UiText GroupZoneHeader}"
                                       Background="#FFC6FDC6" 
                                       Visibility="{StaticResource ZoneVisibility}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Rectangle Margin="47,25"  Stroke="DimGray" StrokeThickness="1" 
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Fill="LightGray" Width="30" Height="20" 
                                   DataContext="{Binding InsertPoint, Mode=OneWay}"
                                   DataContextChanged="OnPreviewDataContextChanged" Grid.Column="1"
                                   />
                        <Rectangle Margin="2,2,2,2"      Stroke="Gray"  StrokeThickness="1" Grid.ColumnSpan="2"/>
                        <Rectangle Margin="47,25,47,25"  Stroke="Black" StrokeThickness="1" Grid.ColumnSpan="2"/>

                        <TextBox Text="A1"
                                 IsReadOnly="True" 
                                 Style="{StaticResource ZoneTextBoxStyle}"
                                 />
                        <TextBox Text="{Binding TopRightZone, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource ZoneTextBoxStyle}" 
                                 />
                        <TextBox Text="{Binding BottomLeftZone, Mode=OneWay}" 
                                 VerticalAlignment="Bottom"
                                 IsReadOnly="True"
                                 Style="{StaticResource ZoneTextBoxStyle}"
                                 />
                        <TextBox Text="{Binding MaxZone}"
                                 VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                 Style="{StaticResource ZoneTextBoxStyle}"
                                 />

                        <TextBox Text="{Binding MarginTop}"
                                 VerticalAlignment="Top"
                                 Style="{StaticResource MarginTextBoxStyle}"
                                 />

                        <TextBox Text="{Binding MarginLeft}" 
                                 HorizontalAlignment="Left" 
                                 Style="{StaticResource MarginTextBoxStyle}"
                                 />

                        <TextBox Text="{Binding MarginRight}"
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource MarginTextBoxStyle}"
                                 />

                        <TextBox Text="{Binding MarginBottom}"
                                 VerticalAlignment="Bottom"
                                 Style="{StaticResource MarginTextBoxStyle}" />
                    </Grid>
                </GroupBox>

                <DockPanel Grid.Row="5" Grid.ColumnSpan="2" LastChildFill="False">
                    <Button Content="{local:UiText ButtonDeleteText}" 
                            Command="{Binding DeleteCommand}"
                            Margin="5" MinWidth="100"
                            Foreground="Crimson" 
                            ToolTip="Entfernt die ausgewählte Formatvorlage"
                            />
                    <Button Content="{local:UiText ButtonAddText}"
                            Command="{Binding AddCommand}"
                            Margin="5" MinWidth="100" 
                            Foreground="Teal" 
                            DockPanel.Dock="Right"
                            ToolTip="Fügt eine neue Formatvorlage der Auswahlt hinzu."
                            />
                    <Button Content="{local:UiText ButtonUpdateText}"
                            Command="{Binding UpdateCommand}"
                            Margin="5" MinWidth="100"
                            DockPanel.Dock="Right"
                            ToolTip="Übernimmt die Änderungen zur ausgewählten Formatvorlage"
                            />
                </DockPanel>
            </Grid>
        </GroupBox>
        <GroupBox Header="{local:UiText GroupSavedFormatsHeader}" Grid.Column="0">
            <ListBox SelectedItem="{Binding SelectedFormat}"
                     ItemsSource="{Binding FormatCollection}"
                     SelectionMode="Single"
                     Grid.IsSharedSizeScope="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:FormatSettings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="Name"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Format"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Margin="10,5" />
                            <TextBlock Grid.Column="1" Text="{Binding SheetFormat}"        Margin="10,5"/>
                            <TextBlock Grid.Column="2" Text="{Binding InsertPoint}"        Margin="10,5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
