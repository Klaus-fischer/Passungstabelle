<UserControl x:Class="Passungstabelle.Settings.TemplateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Passungstabelle.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type local:TemplateViewModel}, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Passungstabelle.Settings;component/Visual/CustomStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Passungstabelle.Settings;component/Visual/ColorResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBoolConverter x:Key="Invert"/>
            <ObjectDataProvider x:Key="LineWidthSource"
                                ObjectType="{x:Type sys:Enum}"
                                MethodName="GetValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="{x:Type local:LineWidth }" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="HeaderPositionSource"
                      ObjectType="{x:Type sys:Enum}"
                      MethodName="GetValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="{x:Type local:HeaderPosition }" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="250"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <GroupBox Header="Gespeicherte Vorlagen" Grid.Column="0">
            <ListBox SelectedItem="{Binding SelectedTemplate}"
                     ItemsSource="{Binding Templates}"
                     SelectionMode="Single"
                     >
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:TemplateSettings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="50" SharedSizeGroup="Name"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Format"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding TableSchemaName }"
                                       FontSize="12" Margin="10,5" />
                            <TextBlock Grid.Column="0" Text="{Binding TemplateNamePattern}" 
                                       Margin="10,5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        
        <GroupBox Header="Templateeinstellungen" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <GroupBox Header="Blattformat Vorlage Dateiname" Grid.Row="0" Grid.Column="1">
                            <HeaderedContentControl Header="Muster" >
                                <TextBox  Text="{Binding SelectedTemplatePattern}"/>
                            </HeaderedContentControl>
                        </GroupBox>
                        <GroupBox Header="{local:UiText TabTableHeader}" Grid.Row="0" Grid.Column="0">
                            <HeaderedContentControl Header="Name" >
                                <ComboBox SelectedValue="{Binding SelectedTableSchemaName}"
                                          ItemsSource="{Binding Tables}"
                                          SelectedValuePath="Name"
                                          DisplayMemberPath="Name"
                                          />
                            </HeaderedContentControl>
                        </GroupBox>
                        <GroupBox Header="{local:UiText TabFormatHeader}">
                            <HeaderedContentControl>
                                <ListBox ItemsSource="{Binding Formats}" >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate  DataType="local:FormatSelector">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="20" SharedSizeGroup="Name"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Format"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Format.Name}" FontSize="12" Margin="10,5" />
                                                <TextBlock Grid.Column="2" Text="{Binding Format.SheetFormat}"        Margin="10,5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </HeaderedContentControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False">
                    <Button Content="{local:UiText ButtonDeleteText}" 
                            Command="{Binding DeleteCommand}"
                            Margin="5" MinWidth="100"
                            Foreground="Crimson" 
                            />

                    <Button Content="&#x23F6;" Margin="5,5,0,5" Padding="2,0,1,2" MinWidth="25"
                            Command="{Binding MoveSelectedUpCommand}"
                            CommandParameter="{Binding SelectedTemplate}"
                            ToolTip="Reihenfolge ändern"
                            />
                    <Button Content="&#x23F7;" Margin="0,5,5,5" Padding="2,0,1,2" MinWidth="25" 
                            Command="{Binding MoveSelectedDownCommand}"
                            CommandParameter="{Binding SelectedTemplate}"
                            ToolTip="Reihenfolge ändern"
                            />
                    <Button Content="{local:UiText ButtonAddText}"
                            Command="{Binding AddCommand}"
                            Margin="5" MinWidth="100" 
                            Foreground="Teal" 
                            DockPanel.Dock="Right"
                            />
                    <Button Content="{local:UiText ButtonUpdateText}"
                            Command="{Binding UpdateCommand}"
                            Margin="5" MinWidth="100"
                            DockPanel.Dock="Right"
                            />
                </DockPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
